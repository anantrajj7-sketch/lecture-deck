.env
__pycache__/
*.pyc
.venv/

# Large source GIS files (India-wide) -- stay local, only the small
# derived static/Data/maharashtra_districts.gpkg is meant to be tracked.
static/Data/STATE_BOUNDARY.*
static/Data/DISTRICT_BOUNDARY.*
static/Data/*.lock

# Raw IMD .GRD download cache -- large, re-downloadable, kept locally as a
# backup so repeat analyses don't need to re-fetch from IMD's servers.
grd_backup/
